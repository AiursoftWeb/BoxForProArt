{
	# Email for Let's Encrypt notifications (certificate expiration, etc.)
	email anduin@aiursoft.com
	
	# Global ACME configuration for Let's Encrypt DNS-01 challenge
	acme_dns cloudflare {env.CLOUDFLARE_API_TOKEN} {
		resolver 1.1.1.1
		# The home router intercepts all UDP port 53 queries for *.aiursoft.com,
		# so certmagic's local DNS propagation check always returns empty.
		# Skip the check (propagation_timeout 0) and wait 60s for Cloudflare
		# to propagate the TXT record before notifying the ACME server.
		propagation_timeout 0
		propagation_delay 60s
	}

	log {
		format json
		output file /data/caddy/logs/web.log {
			roll_size 1gb
			roll_keep 5
			roll_uncompressed
		}
		level info
	}

	servers :443 {
		import cloudflare_trust

		listener_wrappers {
			proxy_protocol {
				timeout 2s
				allow 10.0.0.0/8
			}
			http_redirect
			tls
		}
	}
}

(hsts) {
	header Strict-Transport-Security max-age=63072000
}
