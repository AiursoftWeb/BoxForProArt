{
	"distSpecVersion": "1.0.1",
	"storage": {
		"rootDirectory": "/data",
		"dedupe": true,
		"gc": true,
		"gcInterval": "72h",
		"retention": {
			"dryRun": false,
			"delay": "0h",
			"policies": [
				{
					"repositories": ["**"],
					"deleteReferrers": true,
					"deleteUntagged": true,
					"keepTags": [
						{
							"mostRecentlyPushedCount": 2,
							"pulledWithin": "168h"
						}
					]
				}
			]
		}

	},
	"http": {
		"address": "0.0.0.0",
		"port": "5000",
		"realm": "zot",
		"readTimeout": "2h",
		"writeTimeout": "2h",
		"compat": [
			"docker2s2"
		],
		"externalUrl": "https://hub.aiursoft.com",
		"accessControl": {
			"repositories": {
				"**": {
					"defaultPolicy": [
						"read"
					]
				}
			},
			"adminPolicy": {
				"users": ["anduin@aiursoft.com"],
				"actions": ["read", "create", "update", "delete"]
			}
		},
		"auth": {
			"apikey": true,
			"openid": {
				"providers": {
					"oidc": {
						"credentialsFile": "/config/sso-oidc-credentials.json",
						"name": "Aiursoft",
						"issuer": "https://auth.aiursoft.com/application/o/zot/",
						"keypath": "",
						"scopes": ["openid", "profile", "email"]
					}
				}
			}
		}

	},
	"log": {
		"level": "info",
		"output": "/dev/stdout",
		"audit": "/dev/stdout"
	},
	"extensions": {
		"search": {
			"enable": true
		},
		"scrub": {
			"enable": false
		},
		"ui": {
			"enable": true
		},
		"mgmt": {
			"enable": true
		}
	}
}
