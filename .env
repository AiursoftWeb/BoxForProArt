TTS_ACCESS_TOKEN=YOUR_TTS_ACCESS_TOKEN_HERE

OCR_ACCESS_TOKEN=YOUR_OCR_ACCESS_TOKEN_HERE

ASR_API_TOKEN=YOUR_ASR_API_TOKEN_HERE
ASR_WHISPERX_TOKEN=YOUR_ASR_WHISPERX_TOKEN_HERE

# stage4, stacks.home-power-collector.
# Production values belong in the gitignored .env.prod file.
HOME_ASSISTANT_TOKEN=your_home_assistant_long_lived_access_token
