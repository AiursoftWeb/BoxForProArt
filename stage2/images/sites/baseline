{
	# Email for Let's Encrypt notifications (certificate expiration, etc.)
	email anduin@aiursoft.com
	
	# DNS challenge timing belongs to the ACME issuer, not the DNS provider.
	cert_issuer acme {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
		resolvers 1.1.1.1
		# The router intercepts local UDP DNS; the CA verifies the public TXT record.
		propagation_timeout -1ns
		propagation_delay 60s
	}
	cert_issuer acme {
		dir https://acme.zerossl.com/v2/DV90
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
		resolvers 1.1.1.1
		propagation_timeout -1ns
		propagation_delay 60s
	}

	log {
		format json
		output file /data/caddy/logs/web.log {
			roll_size 1gb
			# Five archives plus the active file cover at most 24 hours with UTC rotation.
			roll_at 00:00 04:00 08:00 12:00 16:00 20:00
			roll_keep 5
			roll_keep_for 24h
			roll_uncompressed
		}
		level info
	}

	servers :443 {
		import cloudflare_trust

		listener_wrappers {
			proxy_protocol {
				timeout 2s
				allow 10.0.0.0/8
			}
			http_redirect
			tls
		}
	}
}

(hsts) {
	header Strict-Transport-Security max-age=63072000
}
