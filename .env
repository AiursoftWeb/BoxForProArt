REGISTRY_HOST=hub.aiursoft.com
REGISTRY_VERIFICATION_IMAGE=mysql:9.7.0
DOCKERHUB_USERNAME=YOUR_DOCKERHUB_USERNAME_HERE
DOCKERHUB_PASSWORD=YOUR_DOCKERHUB_PASSWORD_HERE

# stage2, sites. For setting DNS to aquire TLS certificates.
CLOUDFLARE_API_TOKEN=YOUR_CLOUDFLARE_API_TOKEN_HERE
FRP_SERVER=1.2.3.4
FRP_TOKEN=YOUR_FRP_TOKEN_HERE

# stage3, stacks.puller. For pulling images from public Docker Hub.
PUBLIC_DOCKER_HUB_USERNAME=anduin2019
# Renew this password yearly.
PUBLIC_DOCKER_HUB_PASSWORD=YOUR_PUBLIC_DOCKER_HUB_PASSWORD_HERE
CN_DOCKER_USERNAME=anduin@aiursoft.com
CN_DOCKER_PASSWORD=YOUR_CN_DOCKER_PASSWORD_HERE

# stage4, stacks.clickhouse_outpost. For ClickHouse Outpost service.
CLICKHOUSE_OUTPOST_TOKEN=YOUR_CLICKHOUSE_OUTPOST_TOKEN_HERE
CHARTER_OUTPOST_TOKEN=YOUR_CHARTER_OUTPOST_TOKEN_HERE
RANKING_OUTPOST_TOKEN=YOUR_RANKING_OUTPOST_TOKEN_HERE
LAB_OUTPOST_TOKEN=YOUR_LAB_OUTPOST_TOKEN_HERE
WIKI_OUTPOST_TOKEN=YOUR_WIKI_OUTPOST_TOKEN_HERE
SPEECHES_OUTPOST_TOKEN=YOUR_SPEECHES_OUTPOST_TOKEN_HERE

OLLAMA_GATEWAY_API_KEY=YOUR_OLLAMA_GATEWAY_API_KEY_HERE
OPEN_TERMINAL_API_KEY=YOUR_OPEN_TERMINAL_API_KEY_HERE
OPENWEB_CLIENT_ID=YOUR_OPENWEB_CLIENT_SECRET_HERE
OPENWEB_CLIENT_SECRET=YOUR_OPENWEB_CLIENT_SECRET_KEY_HERE
WEBUI_SECRET_KEY=YOUR_WEBUI_SECRET_KEY_HERE

# stage4, stacks.nuget. For NuGet service.
LOCAL_NUGET_PUBLISH_KEY=YOUR_LOCAL_NUGET_PUBLISH_KEY_HERE
# For nuget.org Renew yearly.
NUGET_API_KEY=YOUR_NUGET_API_KEY_HERE
# For apkg.dev, renew yearly.
APKG_DEV_API_KEY=YOUR_APKG_DEV_API_KEY_HERE
APKG_PROD_API_KEY=YOUR_APKG_PROD_API_KEY_HERE

# Stage 4 OIDC settings for various services.
APKG_DEV_CLIENT_ID=YOUR_APKG_DEV_CLIENT_ID_HERE
APKG_DEV_CLIENT_SECRET=YOUR_APKG_DEV_CLIENT_SECRET_HERE

GRAFANA_CLIENT_ID=YOUR_GRAFANA_CLIENT_ID_HERE
GRAFANA_CLIENT_SECRET=YOUR_GRAFANA_CLIENT_SECRET_HERE

AIURDRIVE_CLIENT_ID=YOUR_AIURDRIVE_CLIENT_ID_HERE
AIURDRIVE_CLIENT_SECRET=YOUR_AIURDRIVE_CLIENT_SECRET_HERE

CPPRUNNER_CLIENT_ID=YOUR_CPPRUNNER_CLIENT_ID_HERE
CPPRUNNER_CLIENT_SECRET=YOUR_CPPRUNNER_CLIENT_SECRET_HERE

GITMIRROR_CLIENT_ID=YOUR_GITMIRROR_CLIENT_ID_HERE
GITMIRROR_CLIENT_SECRET=YOUR_GITMIRROR_CLIENT_SECRET_HERE

S360_CLIENT_ID=Get from Authentik (Client ID)
S360_CLIENT_SECRET=Get from Authentik (Client Secret)
S360_MYSQL_PASSWORD=Replace with a strong random password

OLLAMA_GATEWAY_CLIENT_ID=YOUR_OLLAMA_GATEWAY_CLIENT_ID_HERE
OLLAMA_GATEWAY_CLIENT_SECRET=YOUR_OLLAMA_GATEWAY_CLIENT_SECRET_HERE

GITLAB_CLIENT_ID=YOUR_GITLAB_CLIENT_ID_HERE
GITLAB_CLIENT_SECRET=YOUR_GITLAB_CLIENT_SECRET_HERE
GITLAB_EMAIL_PASSWORD=YOUR_GITLAB_EMAIL_PASSWORD_HERE
GITLAB_RUNNER_TOKEN=YOUR_GITLAB_RUNNER_TOKEN_HERE
GITLAB_RUNNER_TOKEN_FOR_GROUP=YOUR_GITLAB_RUNNER_TOKEN_FOR_GROUP_HERE

NUGET_NINJA_CONTRIBUTE_TOKEN=YOUR_NUGET_NINJA_CONTRIBUTE_TOKEN_HERE
NUGET_NINJA_MERGE_TOKEN=YOUR_NUGET_NINJA_MERGE_TOKEN_HERE

AGENT_BOT_API_KEY=YOUR_DEEPSEEK_API_KEY_HERE
